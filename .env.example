# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=7d

# Database
DATABASE_URL=replace_with_postgresql_connection_url
# Admin seed credentials
ADMIN_PHONE=replace_with_admin_phone
ADMIN_PASSWORD=replace_with_strong_admin_password

# Super Admin seed credentials
SUPER_ADMIN_PHONE=replace_with_super_admin_phone
SUPER_ADMIN_EMAIL=replace_with_super_admin_email
SUPER_ADMIN_PASSWORD=replace_with_strong_super_admin_password
SUPER_ADMIN_NAME=replace_with_super_admin_name

# SMTP provider for super-admin password reset OTP emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=replace_with_sender_email

# AfroMessage SMS (for mobile forgot-password OTP)
# Get your API key from https://afromessage.com
AFROMESSAGE_API_KEY=replace_with_your_afromessage_api_key
AFROMESSAGE_SENDER_ID=Shmeta
AFROMESSAGE_IDENTIFIER=replace_with_your_identifier_id
